name = "howtomakeaname/sumi"

version = "0.3.0"

readme = "../README.md"

repository = "https://github.com/howtomakeaname/sumi.mbt"

license = "Apache-2.0"

keywords = [ "ui", "components", "web", "theming", "dark-mode" ]

description = "A UI component library for MoonBit web apps — dark & light themes, overlay motion, zero config"

preferred_target = "js"

supported_targets = "js+native+wasm"

import {
  "moonbit-community/rabbita@0.16.3",
}
